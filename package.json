{
  "name": "openflow-studio",
  "version": "2.5.3",
  "description": "OpenFlow Studio — AIGC 广告生产力工作流工具",
  "author": "mxw86",
  "private": true,
  "openflowRelease": {
    "updateType": "standard"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MXWStudio/OpenFlow.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "sync:extension-version": "node scripts/extension-version.mjs",
    "check:extension-version": "node scripts/extension-version.mjs --check",
    "prepare:extension": "node scripts/prepare-extension-package.mjs",
    "prepare:update-config": "node scripts/prepare-update-config.mjs",
    "prepare:build-metadata": "node scripts/prepare-build-metadata.mjs",
    "prepare:update-feed-local": "node scripts/prepare-local-update-feed.mjs",
    "serve:update-feed-local": "node scripts/serve-local-update-feed.mjs",
    "release:generate-keys": "node scripts/generate-release-keypair.mjs",
    "predev": "npm run prepare:extension && npm run prepare:update-config && node scripts/prepare-build-metadata.mjs --channel dev",
    "dev": "electron-vite dev",
    "prebuild": "npm run prepare:extension && npm run prepare:update-config && node scripts/prepare-build-metadata.mjs --channel stable",
    "build": "electron-vite build && node scripts/upload-sentry-sourcemaps.mjs && electron-builder --win --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "build:app": "electron-vite build",
    "build:windows:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-channel.ps1 -Channel Dev",
    "build:windows:candidate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-channel.ps1 -Channel Candidate",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:extension": "npm run check:extension-version && node scripts/check-chrome-extension.mjs && node scripts/test-chrome-deadline-extraction.mjs && node scripts/test-chrome-update-flow.mjs",
    "check:release": "node --test scripts/*.test.mjs",
    "test": "npm run check:extension && npm run check:release && node --test src/main/*.test.ts src/renderer/src/*.test.ts src/shared/*.test.ts",
    "test:e2e": "node scripts/prepare-build-metadata.mjs --channel dev && npm run prepare:extension && npm run prepare:update-config && electron-vite build && playwright test",
    "test:e2e:packaged": "playwright test",
    "verify:windows:remote": "bash scripts/remote-windows-electron.sh",
    "verify:windows:candidate": "bash scripts/remote-windows-electron.sh --candidate",
    "version": "npm run sync:extension-version"
  },
  "build": {
    "appId": "com.openflow.studio",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "MXWStudio",
        "repo": "OpenFlow"
      }
    ],
    "files": [
      "out/**/*",
      "icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".openflow-build/chrome-extension",
        "to": "chrome-extension"
      },
      {
        "from": ".openflow-build/update-config.json",
        "to": "update-config.json"
      },
      {
        "from": ".openflow-build/build-metadata.json",
        "to": "build-metadata.json"
      }
    ],
    "win": {
      "icon": "icons/icon.png",
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "build-dist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenFlow Studio"
    }
  },
  "dependencies": {
    "@dicebear/core": "^9.4.0",
    "@dicebear/dylan": "^9.4.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@mantine/core": "^8.3.18",
    "@mantine/dropzone": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@sentry/electron": "7.16.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.3.4",
    "lucide-react": "^0.546.0",
    "pinyin-pro": "^3.28.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@sentry/cli": "3.6.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0"
  }
}
